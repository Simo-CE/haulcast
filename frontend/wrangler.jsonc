// Cloudflare Worker (free plan): serves dist/ and proxies /api/* to the Django API on Render.
// Deploy: npm run build && npx wrangler@4.149.0 deploy
{
  "name": "haulcast",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_URL": "https://haulcast.onrender.com"
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "haulcast.dooma.dev", "custom_domain": true }]
}
